{
  "domain": "specs",
  "use_default_fallback": false,
  "source_drive": "D:",
  "source_root": "./testing/source",
  "source_subdirs": [
    ".",
    "1",
    "dev/specs"
  ],
  "destination_drive": "D:",
  "destination_root": "./testing",
  "paths": {
    "stage_dir": "repo/stage",
    "repo_items_dir": "repo/specs",
    "eject_dir": "unspec",
    "stage_ledger": "custom_logs/",
    "spec_manifest": "custom_logs/",
    "lock_file": "repo/.harvester.lock",
    "digests_dir": "digests"
  },
  "rules": {
    "primary_spec_regex": "/[_-]specs?\\.[^.]+$/i",
    "antipattern_regex": "/(?:^|[-_.,0-9])(?:unspec|unitem|exitm)(?:$|[-_.,0-9])/i"
  }
}
